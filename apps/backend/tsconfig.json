{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Node",
        "strict": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "outDir": "./dist",
        "declaration": true,
        "emitDeclarationOnly": false,
        "forceConsistentCasingInFileNames": true,
        "allowImportingTsExtensions": false,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "noEmit": false,
        "baseUrl": ".",
        "paths": {
            "@config/*": [
                "src/config/*"
            ],
            "@routes/*": [
                "src/routes/*"
            ],
            "@controllers/*": [
                "src/controllers/*"
            ],
            "@middleware/*": [
                "src/middleware/*"
            ],
            "@models/*": [
                "src/models/*"
            ],
            "@services/*": [
                "src/services/*"
            ],
            "@utils/*": [
                "src/utils/*"
            ],
            "@types/*": [
                "../../packages/types/src/*"
            ]
        },
    },
    "ts-node": {
        "compilerOptions": {
            "module": "ESNext"
        },
    },
    "include": [
        "src",
        "../../packages/types",
    ],
    "exclude": [
        "node_modules"
    ],
    "references": [
        {
            "path": "../../packages/types"
        }
    ]
}